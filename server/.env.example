# --- Base MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mce_academy

# --- Sécurité : clé de signature des sessions (longue chaîne aléatoire) ---
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
JWT_TTL=7d

# --- Serveur ---
PORT=4000
# URL(s) du frontend autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
UPLOAD_MAX_MB=200

# --- Premier administrateur (utilisé par `npm run seed`) ---
ADMIN_EMAIL=admin@mce-academy.com
ADMIN_PASSWORD=ChangezMoi!2026
ADMIN_NAME=Administrateur MCE

# Créer aussi une entreprise de démo (VIGILUS) avec cours, formateur et apprenants : true / false
SEED_DEMO=true
