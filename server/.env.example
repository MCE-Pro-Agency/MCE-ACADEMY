# Copier ce fichier en server/.env et le remplir. Ne JAMAIS committer server/.env.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://loifdnwmqjlwucruqhiw.supabase.co
# Clé service_role (secrète) : uniquement ici, jamais dans le frontend ni dans Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Serveur ---
PORT=4000
# development ou production (en production, les erreurs internes ne sont pas détaillées au navigateur)
NODE_ENV=development
# URL(s) du frontend autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
# Adresse du site utilisée dans les liens des e-mails (invitation, mot de passe oublié).
# En production : l'URL officielle du site, à ajouter aussi dans Supabase > Authentication > URL Configuration.
APP_URL=http://localhost:5173

# --- Premier administrateur (utilisé par `npm run seed`) ---
ADMIN_EMAIL=admin@mce-academy.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur MCE

# Créer aussi une entreprise de démo (VIGILUS) avec cours, formateur et apprenants : true / false
# Ne pas activer sur la base de production : les comptes de démo ont des mots de passe connus.
SEED_DEMO=false
